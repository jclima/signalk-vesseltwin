{
  "name": "signalk-vesseltwin",
  "version": "0.2.2",
  "description": "SignalK server plugin that pairs a boat with VesselTwin and, when you turn it on, sends engine hours, battery and tank readings to its maintenance record. Off by default; never sends position or MMSI.",
  "license": "Apache-2.0",
  "author": "VesselTwin contributors",
  "homepage": "https://github.com/jclima/signalk-vesseltwin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jclima/signalk-vesseltwin.git"
  },
  "bugs": {
    "url": "https://github.com/jclima/signalk-vesseltwin/issues"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-cloud",
    "signalk-category-utility",
    "vesseltwin",
    "boat",
    "maintenance",
    "engine-hours"
  ],
  "signalk": {
    "displayName": "VesselTwin",
    "appIcon": "./icon.png"
  },
  "main": "plugin/index.js",
  "types": "plugin/index.d.ts",
  "files": [
    "plugin",
    "public",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "rm -rf plugin public/*.js && tsc -p tsconfig.build.json && tsc -p web",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . && prettier --check . && node scripts/check-public.mjs && node scripts/release-check.mjs --ci",
    "check:public": "node scripts/check-public.mjs",
    "check:pack": "node scripts/check-public.mjs --pack",
    "check:release": "node scripts/release-check.mjs",
    "preflight": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:pack",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
